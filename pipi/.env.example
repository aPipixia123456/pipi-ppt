# Supply real values via deployment environment/secret manager, never commit them.
POSTGRES_PASSWORD=
PIPI_CREDENTIAL_KEY=
PIPI_GATEWAY_URL=https://pipixia1.online
PIPI_PUBLIC_URL=https://ppt.pipixia1.online
# gateway uses the user's pipiapi /v1/alpha/search authorization.
PIPI_RESEARCH_PROVIDER=gateway
# Set PIPI_RESEARCH_PROVIDER=minimax to use the M Plan Web Search subscription.
PIPI_MINIMAX_API_HOST=https://api.minimaxi.com
PIPI_MINIMAX_API_KEY=
# Used only by the gateway provider; leave empty to use the selected text model.
PIPI_RESEARCH_MODEL=
PIPI_PORT=3100
